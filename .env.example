# Configure these in the Airflow process environment. Store credentials in
# Airflow Connections or its secrets backend, never in this project.
AIRBNB_GCS_BUCKET=your-data-bucket
AIRBNB_GCS_PREFIX=data/raw/
AIRBNB_GCP_CONNECTION_ID=google_cloud_default
AIRBNB_POSTGRES_CONNECTION_ID=postgres_default
CENSUS_G01_OBJECT=data/census/2016Census_G01_NSW_LGA.csv
CENSUS_G02_OBJECT=data/census/2016Census_G02_NSW_LGA.csv
LGA_CODE_OBJECT=data/mapping/NSW_LGA_CODE.csv
LGA_SUBURB_OBJECT=data/mapping/NSW_LGA_SUBURB.csv

# dbt only; use a database role permitted to create the project schemas.
DBT_POSTGRES_HOST=localhost
DBT_POSTGRES_PORT=5432
DBT_POSTGRES_DATABASE=analytics
DBT_POSTGRES_USER=analytics
DBT_POSTGRES_PASSWORD=
